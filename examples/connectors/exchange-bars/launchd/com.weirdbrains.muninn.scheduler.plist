<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Muninn scheduler: runs connector schedules such as exchange-bars at login. -->
	<key>Label</key>
	<string>com.weirdbrains.muninn.scheduler</string>
	<key>ProgramArguments</key>
	<array>
		<string>__HOME__/.local/bin/muninn-scheduler</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<!-- restart if it exits (crash, missing Keychain item); not more often than every 60 s -->
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>60</integer>
	<key>ProcessType</key>
	<string>Background</string>
	<key>StandardOutPath</key>
	<string>__HOME__/Library/Logs/muninn-scheduler.log</string>
	<key>StandardErrorPath</key>
	<string>__HOME__/Library/Logs/muninn-scheduler.log</string>
</dict>
</plist>
