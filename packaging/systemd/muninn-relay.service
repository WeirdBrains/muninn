[Unit]
Description=Muninn relay node
Documentation=https://github.com/WeirdBrains/muninn/blob/main/docs/deploy-relay.md
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=muninn
Group=muninn
Environment=MUNINN_HOME=/var/lib/muninn
Environment=MUNINN_NON_INTERACTIVE=true
Environment=MUNINN_LOG=info
# MUNINN_PASSWORD=... (root-only, mode 600)
EnvironmentFile=/etc/muninn/relay.env
ExecStart=/usr/bin/mnnn net start --relay-server --no-mdns
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
KillSignal=SIGINT
LimitNOFILE=65536

# port 80 for the Let's Encrypt HTTP-01 challenge
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/muninn
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
