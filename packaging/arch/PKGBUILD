# Build and install Muninn from this git checkout (needs Rust; no download of Muninn
# itself, so it works while the GitHub repo is private and before any release exists):
#   cd packaging/arch && makepkg -si
# It builds the last *committed* state of the checkout's current branch.
# For the prebuilt binary from a published GitHub release, use muninn-bin/PKGBUILD.
# Maintainer: Michael Christenson II <m3talsmith@gmail.com>
pkgname=muninn
pkgver=1.13.0
pkgrel=1
pkgdesc="Local, encrypted store for OHLCV market bars (mnnn)"
arch=('x86_64' 'aarch64')
url="https://github.com/kommandosaldat/muninn"
license=('MIT')
depends=('libgcc' 'glibc')
makedepends=('cargo' 'git' 'perl' 'make')
provides=('mnnn')
conflicts=('muninn-bin')
options=('!lto')
_checkout="$(cd "${startdir:-$PWD}/../.." && pwd)"
source=("muninn::git+file://$_checkout")
sha256sums=('SKIP')

pkgver() {
  sed -n 's/^version = "\(.*\)"/\1/p' "$srcdir/muninn/Cargo.toml" | head -1
}

prepare() {
  cd muninn
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd muninn
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

check() {
  cd muninn
  ./target/release/mnnn --version
}

package() {
  cd muninn
  install -Dm755 target/release/mnnn "$pkgdir/usr/bin/mnnn"
  install -Dm644 -t "$pkgdir/usr/share/man/man1" man/*.1
  install -Dm644 -t "$pkgdir/usr/share/doc/$pkgname" README.md CHANGELOG.md
  cp -r docs "$pkgdir/usr/share/doc/$pkgname/"
  rm -rf "$pkgdir/usr/share/doc/$pkgname/docs/historical"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
