# Maintainer: Michael Christenson II <m3talsmith@gmail.com>
# Binary package: installs the prebuilt binary attached to a published GitHub release
# (vX.Y.Z assets from .github/workflows/release.yml). No Rust needed, but the release
# must exist and be downloadable (public repo); otherwise use ../PKGBUILD or
# ../build-local.sh.
pkgname=muninn-bin
pkgver=2.14.0
pkgrel=1
pkgdesc="Local, encrypted store for OHLCV market bars (mnnn), prebuilt"
arch=('x86_64' 'aarch64')
url="https://github.com/kommandosaldat/muninn"
license=('MIT')
depends=('libgcc' 'glibc')
provides=('muninn' 'mnnn')
conflicts=('muninn')
options=('!strip' '!debug')
source_x86_64=("$url/releases/download/v$pkgver/muninn-$pkgver-$CARCH-unknown-linux-gnu.tar.gz")
source_aarch64=("$url/releases/download/v$pkgver/muninn-$pkgver-$CARCH-unknown-linux-gnu.tar.gz")
# Filled from the release's SHA256SUMS when published (updpkgsums).
sha256sums_x86_64=('SKIP')
sha256sums_aarch64=('SKIP')

package() {
  cd "muninn-$pkgver-$CARCH-unknown-linux-gnu"
  install -Dm755 mnnn "$pkgdir/usr/bin/mnnn"
  install -Dm644 -t "$pkgdir/usr/share/man/man1" man/*.1
  install -Dm644 -t "$pkgdir/usr/share/doc/muninn" README.md CHANGELOG.md
  cp -r docs "$pkgdir/usr/share/doc/muninn/"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  [[ -f LICENSE-FONTS ]] && install -Dm644 LICENSE-FONTS "$pkgdir/usr/share/licenses/$pkgname/LICENSE-FONTS"
}
